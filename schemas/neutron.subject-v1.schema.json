{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrei-ilyushchyts-0x01/neutron/schemas/neutron.subject-v1.schema.json",
  "title": "Resolved native/system subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selector",
    "roots"
  ],
  "properties": {
    "schema": {
      "const": "neutron.subject/v1"
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "package"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "uid"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "executable"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "pids"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pid",
                  "starttime"
                ],
                "properties": {
                  "pid": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "starttime": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "service"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transport",
                "endpoint"
              ],
              "properties": {
                "transport": {
                  "enum": [
                    "binder",
                    "vndbinder",
                    "hwbinder"
                  ]
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            }
          }
        }
      ]
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boot_id",
          "pid",
          "starttime",
          "uid",
          "gid",
          "executable",
          "selinux_domain"
        ],
        "properties": {
          "boot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "pid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "starttime": {
            "type": "integer",
            "minimum": 1
          },
          "uid": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "gid": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          },
          "selinux_domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  }
}
