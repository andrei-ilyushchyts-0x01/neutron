{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrei-ilyushchyts-0x01/neutron/schemas/neutron.external-evidence-v2.schema.json",
  "title": "Imported external evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "subject_id",
    "measured_by",
    "claim_type",
    "imported_from",
    "artifact_path",
    "artifact_sha256",
    "health_status",
    "claim_scope",
    "probe_identity",
    "stimulus_identity"
  ],
  "properties": {
    "schema": {
      "const": "neutron.external-evidence/v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096,
      "pattern": "^service:[!-~]+$"
    },
    "measured_by": {
      "const": "external_probe"
    },
    "claim_type": {
      "enum": [
        "declared",
        "live_mapped",
        "observed_edge",
        "not_observed_clean",
        "lookup_unavailable",
        "call_denied",
        "call_succeeded"
      ]
    },
    "imported_from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^external-evidence/[A-Za-z0-9._-]+\\.artifact$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "health_status": {
      "enum": [
        "complete",
        "degraded",
        "incomplete",
        "unknown"
      ]
    },
    "claim_scope": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procedure",
            "caller",
            "attempt_count"
          ],
          "properties": {
            "procedure": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "caller": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "attempt_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        }
      ]
    },
    "probe_identity": {
      "type": "null"
    },
    "stimulus_identity": {
      "$ref": "neutron.stimulus-identity-v1.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stimulus_identity": {
            "properties": {
              "kind": {
                "const": "native_process"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "claim_scope": {
            "type": "object"
          }
        }
      }
    }
  ]
}
