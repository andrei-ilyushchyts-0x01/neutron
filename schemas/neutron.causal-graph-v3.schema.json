{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrei-ilyushchyts-0x01/neutron/schemas/neutron.causal-graph-v3.schema.json",
  "title": "Causal graph with capture passport and evidence basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodes",
    "edges",
    "passport",
    "view"
  ],
  "properties": {
    "schema": {
      "const": "neutron.causal-graph/v3"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "relation",
          "evidence_basis"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "kind": {
            "enum": [
              "causal_parent",
              "process_membership",
              "binder_target"
            ]
          },
          "relation": {
            "enum": [
              "exact",
              "inferred",
              "unknown"
            ]
          },
          "evidence_basis": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "passport": {
      "$ref": "neutron.capture-passport-v1.schema.json"
    },
    "view": {
      "type": "object"
    }
  }
}
