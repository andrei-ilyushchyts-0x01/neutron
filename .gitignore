.env
.env.local
.env.*.local

# Editor / OS noise
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# AI tooling local state
.codex
.claude/
.codesight/
.aider*

# Python (training scripts venvs)
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Misc
*.bak
*.tmp
